# Copy this file to .env.local and fill in the values from the Firebase Console:
# Project: inzone-f93e4 → Project settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inzone-f93e4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inzone-f93e4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inzone-f93e4.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=912424781531
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only (Unity publish route /api/unity-publish) ─────────────────────
# Service-account JSON (raw or base64) for the Admin SDK. NOT NEXT_PUBLIC_*, so
# it never reaches the browser. Needs Storage Object Admin on inzone-unity-bundles
# + Firestore write. Same service account as scripts/service-account-key.json in
# the Flutter repo (project inzone-f93e4). On Vercel, set this as an Encrypted env.
FIREBASE_SERVICE_ACCOUNT=
# Local-dev ONLY: set to 1 to skip ID-token auth on the publish route. Never in prod.
UNITY_PUBLISH_ALLOW_UNAUTH=

# Backend API origin for trusted-host checkout and save/load. HTTPS origin only
# (loopback HTTP allowed in tests). Do not enable INZONE_OFFER_CHECKOUT_* here.
NEXT_PUBLIC_INZONE_API_ORIGIN=https://inzoneapi-912424781531.us-central1.run.app

# Isolated web SDK host is opt-in (comma-separated game ids). Empty = all hub
# games keep the legacy same-origin player iframe.
# NEXT_PUBLIC_INZONE_WEB_SDK_GAMES=

# Local Firebase emulators only (Auth :9099, Firestore :8080). Never production.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1

# ── Meta Pixel (website dataset for ad account 1200604131220857) ─────────────
# Public 16-digit web pixel id issued by Meta for inzone.games. Ships to every
# browser in the base script, so it is not a secret. Defaults to the production
# id in components/MetaPixel.tsx; set this to point staging / preview at a
# different dataset. Only VERIFIED_GAMEPLAY_EVENTS (game_start, engaged_play,
# first_game_over, return_play) are sent — never proxies, session ids, chat, or
# invite links.
# NEXT_PUBLIC_META_PIXEL_ID=2983764635290155

# ── TikTok Ads (read-only reporting + pixel) ─────────────────────────────────
# Public TikTok pixel id, safe to ship in the base script. Empty = the
# TikTok pixel component is a no-op. Same VERIFIED_GAMEPLAY_EVENTS gate as
# the Meta pixel. Setup steps: docs/TIKTOK_INTEGRATION.md.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Server-only. Marketing API access token — issued from a Developer App with
# READ scopes only (`ad.read`, `reports.read`). Never NEXT_PUBLIC_*, never
# imported by a 'use client' module. Set as Encrypted in Vercel.
# TIKTOK_ACCESS_TOKEN=
# Numeric advertiser id from Business Center. Not sensitive but not client-side.
# TIKTOK_ADVERTISER_ID=
# Optional. Developer App id — kept server-side for hygiene.
# TIKTOK_APP_ID=

# ── Spoken companion (server-only provider keys) ───────────────────────────
# Temporary display name until Jayme approves the final one.
# NEXT_PUBLIC_COMPANION_NAME=Rook
# Speech generation only. Do not put provider keys in NEXT_PUBLIC_*.
# Do not reuse any Flutter-exposed client key.
# Little Chapters @ 9b19d6a: NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs is not required.
# Unset or elevenlabs attempts ElevenLabs when ELEVENLABS_API_KEY is present.
# web-speech forces the browser fallback (rate 0.95, pitch 1.05).
# NEXT_PUBLIC_VOICE_PROVIDER=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=          # optional; default EXAVITQu4vr4xnSDxMaL (source-labeled Rachel)
# ELEVENLABS_MODEL_ID=eleven_turbo_v2
# Conversational reasoning (not speech). Same key may already exist for TTS.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional speech fallback when ElevenLabs is unset:
# OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Shared paid quotas require FIREBASE_SERVICE_ACCOUNT on the hosted Preview.
# Missing Admin credentials must not authorize OpenAI/ElevenLabs via
# process-local maps; the route keeps the free fallback and names this
# setting. Do not deploy the entire firestore.rules file as incidental
# setup — unmatched paths already deny clients. See docs/COMPANION_QUOTA.md.
# Identity: anonymous Firebase ID tokens are accepted. Prefer
# FIREBASE_SERVICE_ACCOUNT for Admin verifyIdToken; otherwise the route uses
# Identity Toolkit accounts:lookup with NEXT_PUBLIC_FIREBASE_API_KEY.
# NEXT_PUBLIC_APP_URL=          # optional override for speech probe scripts
