rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function gameOwner(gameId) {
      return get(/databases/$(database)/documents/html_games/$(gameId)).data.uploaderId;
    }

    match /html_games/{gameId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uploaderId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uploaderId == request.auth.uid
        && request.resource.data.uploaderId == resource.data.uploaderId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn()
        && resource.data.uploaderId == request.auth.uid;

      match /versions/{versionId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn()
          && gameOwner(gameId) == request.auth.uid;
      }

      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      match /transactions/{txId} {
        allow read: if isSignedIn()
          && gameOwner(gameId) == request.auth.uid;
        allow write: if false;
      }

      match /likes/{actorId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasOnly(
            ['actorId', 'actorName', 'anonymous', 'createdAt'])
          && request.resource.data.actorId is string
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() <= 80;
        allow delete: if true;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(
            ['authorId', 'authorName', 'anonymous', 'text',
             'parentId', 'likeCount', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.likeCount == 0;
        allow update: if request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['likeCount'])
          && request.resource.data.likeCount is number
          && request.resource.data.likeCount >= 0;
        allow delete: if false;
      }
    }

    match /revenueSummary/{gameId} {
      allow read: if isSignedIn()
        && gameOwner(gameId) == request.auth.uid;
      allow write: if false;
    }

    match /game_coin_transactions/{txId} {
      allow read: if isSignedIn()
        && gameOwner(resource.data.game_id) == request.auth.uid;
      allow write: if false;
    }

    match /game_sdk_metrics/{bucketId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /server_deployments/{deploymentId} {
      allow read: if isSignedIn()
        && (resource == null
            || resource.data.uploaderId == request.auth.uid);
      allow write: if false;

      match /logs/{logId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /humanUsers/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /referralHistory/{entryId} {
        allow read, create: if isSignedIn()
          && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participants;
        allow update, delete: if false;
      }
    }

    match /groupChats/{chatId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /aiPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /humanPosts/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /reposts/{repostId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /postComments/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /notificationsQueue/{queueId} {
      allow read: if false;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /reportPost/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /reportUser/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /reportGroupParticipant/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /aiChatHistory/{chatId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /voice_conversations/{convId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /voice_analytics/{docId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.installerId == request.auth.uid;
      allow delete: if false;
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.token.admin == true;
    }

    match /popularCharacters/{id} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.token.admin == true;
    }

    match /avatars/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /content/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /influencers/{id} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.auth.uid == id
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == id;
      }
    }

    match /readingPets/{uid} {
      allow read, write: if isSignedIn()
        && request.auth.uid == uid;
    }

    match /aiUsers/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /messages/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /parents/{uid} {
      allow read: if isSignedIn()
        && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys()
            .hasOnly(['phoneNumber', 'updatedAt'])
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber
            .matches('^[+][1-9][0-9]{6,14}$');
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['phoneNumber', 'updatedAt'])
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber
            .matches('^[+][1-9][0-9]{6,14}$');
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid == uid;
        allow update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      match /children/{childId} {
        allow read, write: if isSignedIn()
          && request.auth.uid == uid;

        match /progress/{progressId} {
          allow read, write: if isSignedIn()
            && request.auth.uid == uid;
        }

        match /sessions/{sessionId} {
          allow read, write: if isSignedIn()
            && request.auth.uid == uid;
        }
      }
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /influencers_referral_stats/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /ledger_entries/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /unityGames/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /playSessions/{sessionId} {
      function playUid() {
        return request.auth.uid;
      }

      function playAuthed() {
        return isSignedIn()
          && playUid() is string
          && playUid() != '';
      }

      function playIdOk() {
        return sessionId.matches('^[0-9a-f]{32}$');
      }

      function playKeys() {
        return [
          'hostId', 'createdAt', 'gameId', 'status',
          'memberIds', 'memberNames', 'latestSeq'
        ];
      }

      function playUnexpired() {
        return resource.data.createdAt is timestamp
          && resource.data.createdAt + duration.value(24, 'h')
            > request.time;
      }

      function playHostFrozen() {
        return request.resource.data.hostId == resource.data.hostId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.latestSeq == resource.data.latestSeq;
      }

      function playOnly(fields) {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(fields);
      }

      function playParent() {
        return get(
          /databases/$(database)/documents/playSessions/$(sessionId)
        ).data;
      }

      function playMemberNow() {
        return playAuthed()
          && playUid() in playParent().memberIds;
      }

      function playParentOpen() {
        return playParent().status == 'open'
          && playParent().createdAt is timestamp
          && playParent().createdAt + duration.value(24, 'h')
            > request.time;
      }

      function playMsgChat(msg) {
        return msg.keys().hasOnly([
            'type', 'senderId', 'senderName', 'text', 'createdAt'
          ])
          && msg.type == 'chat'
          && msg.senderId == playUid()
          && msg.senderName is string
          && msg.senderName.size() > 0
          && msg.senderName.size() <= 80
          && msg.text is string
          && msg.text.size() > 0
          && msg.text.size() <= 500
          && msg.createdAt == request.time;
      }

      function playMsgSuggest(msg) {
        return msg.keys().hasOnly([
            'type', 'senderId', 'senderName', 'text', 'createdAt',
            'gameId', 'gameName', 'gameIconUrl'
          ])
          && msg.type == 'suggest'
          && msg.senderId == playUid()
          && msg.senderName is string
          && msg.senderName.size() > 0
          && msg.senderName.size() <= 80
          && msg.text is string
          && msg.text.size() > 0
          && msg.text.size() <= 500
          && msg.gameId is string
          && msg.gameId.size() > 0
          && msg.gameId.size() <= 128
          && msg.gameName is string
          && msg.gameName.size() > 0
          && msg.gameName.size() <= 120
          && msg.gameIconUrl is string
          && msg.gameIconUrl.size() <= 2000
          && msg.createdAt == request.time;
      }

      function playNewMessageOk() {
        return request.resource.data.latestMessageId is string
          && request.resource.data.latestMessageId.size() > 0
          && request.resource.data.latestMessageId.size() <= 64
          && request.resource.data.latestMessageId
            in request.resource.data.messages
          && request.resource.data.lastPosted
            .diff(resource.data.lastPosted)
            .affectedKeys().hasOnly([playUid()])
          && request.resource.data.lastPosted[playUid()] == request.time
          && (
            playMsgChat(
              request.resource.data.messages[
                request.resource.data.latestMessageId
              ]
            )
            || playMsgSuggest(
              request.resource.data.messages[
                request.resource.data.latestMessageId
              ]
            )
          );
      }

      function playIsJoin() {
        return resource.data.status == 'open'
          && request.resource.data.status == 'open'
          && playUnexpired()
          && playHostFrozen()
          && !(playUid() in resource.data.memberIds)
          && playUid() in request.resource.data.memberIds
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= 8
          && request.resource.data.memberIds
            .hasAll(resource.data.memberIds)
          && playOnly(['memberIds', 'memberNames'])
          && request.resource.data.memberNames
            .diff(resource.data.memberNames)
            .affectedKeys().hasOnly([playUid()])
          && request.resource.data.memberNames[playUid()] is string
          && request.resource.data.memberNames[playUid()].size() > 0
          && request.resource.data.memberNames[playUid()].size() <= 80;
      }

      function playIsLeave() {
        return playUid() in resource.data.memberIds
          && !(playUid() in request.resource.data.memberIds)
          && request.resource.data.memberIds.size()
            == resource.data.memberIds.size() - 1
          && resource.data.memberIds
            .hasAll(request.resource.data.memberIds)
          && playHostFrozen()
          && request.resource.data.memberNames
            .diff(resource.data.memberNames)
            .affectedKeys().hasOnly([playUid()])
          && !(playUid() in request.resource.data.memberNames)
          && (
            request.resource.data.memberIds.size() == 0
              ? playOnly(['memberIds', 'memberNames', 'status'])
                  && request.resource.data.status == 'ended'
              : playOnly(['memberIds', 'memberNames'])
                  && request.resource.data.status == resource.data.status
          );
      }

      allow get: if playAuthed() && (
        playUid() in resource.data.memberIds
        || (resource.data.status == 'open' && playUnexpired())
      );

      allow list: if false;

      allow create: if playAuthed()
        && playIdOk()
        && request.resource.data.keys().hasOnly(playKeys())
        && request.resource.data.hostId == playUid()
        && request.resource.data.createdAt == request.time
        && request.resource.data.gameId is string
        && request.resource.data.gameId.size() <= 128
        && request.resource.data.status == 'open'
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == playUid()
        && request.resource.data.memberNames.keys().hasOnly([playUid()])
        && request.resource.data.memberNames[playUid()] is string
        && request.resource.data.memberNames[playUid()].size() > 0
        && request.resource.data.memberNames[playUid()].size() <= 80
        && request.resource.data.latestSeq == 0;

      function playIsAdvance() {
        return playAuthed()
          && playUid() in resource.data.memberIds
          && playOnly(['latestSeq'])
          && request.resource.data.hostId == resource.data.hostId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.status == resource.data.status
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.latestSeq is int
          && request.resource.data.latestSeq == resource.data.latestSeq + 1
          && exists(
            /databases/$(database)/documents/playSessions/$(sessionId)/chunks/$(string(request.resource.data.latestSeq))
          );
      }

      allow update: if playAuthed()
        && (playIsJoin() || playIsLeave() || playIsAdvance());

      allow delete: if false;

      match /chunks/{chunkId} {
        function playChunkKeys() {
          return [
            'seq', 'lastPosted', 'messages',
            'latestMessageId', 'memberIds'
          ];
        }

        function playIsChunkPost() {
          return playParentOpen()
            && request.resource.data.seq == resource.data.seq
            && playOnly(['messages', 'lastPosted', 'latestMessageId'])
            && !(request.resource.data.latestMessageId
              in resource.data.messages)
            && request.resource.data.messages.keys().size()
              == resource.data.messages.keys().size() + 1
            && request.resource.data.messages.keys()
              .hasAll(resource.data.messages.keys())
            && request.resource.data.messages.diff(resource.data.messages)
              .affectedKeys()
              .hasOnly([request.resource.data.latestMessageId])
            && request.resource.data.messages.keys().size() <= 40
            && playUid() in resource.data.memberIds
            && (
              !(playUid() in resource.data.lastPosted)
              || request.time > resource.data.lastPosted[playUid()]
                + duration.value(800, 'ms')
            )
            && playNewMessageOk();
        }

        function playIsChunkOpen() {
          return playMemberNow()
            && playParentOpen()
            && chunkId.matches('^[0-9]{1,6}$')
            && request.resource.data.keys().hasOnly(playChunkKeys())
            && request.resource.data.seq is int
            && request.resource.data.seq >= 0
            && chunkId == string(request.resource.data.seq)
            && request.resource.data.messages.size() == 1
            && request.resource.data.lastPosted[playUid()] == request.time
            && request.resource.data.latestMessageId
              in request.resource.data.messages
            && (
              playMsgChat(
                request.resource.data.messages[
                  request.resource.data.latestMessageId
                ]
              )
              || playMsgSuggest(
                request.resource.data.messages[
                  request.resource.data.latestMessageId
                ]
              )
            )
            && request.resource.data.memberIds == playParent().memberIds
            && playUid() in request.resource.data.memberIds;
        }

        function playIsChunkAdmit() {
          return playMemberNow()
            && playParentOpen()
            && playOnly(['memberIds'])
            && !(playUid() in resource.data.memberIds)
            && playUid() in request.resource.data.memberIds
            && request.resource.data.memberIds.size()
              == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds
              .hasAll(resource.data.memberIds);
        }

        function playIsChunkLeave() {
          return playAuthed()
            && playUid() in resource.data.memberIds
            && !(playUid() in request.resource.data.memberIds)
            && playOnly(['memberIds'])
            && resource.data.memberIds.size()
              == request.resource.data.memberIds.size() + 1
            && resource.data.memberIds
              .hasAll(request.resource.data.memberIds);
        }

        allow get: if playMemberNow();
        allow list: if false;

        allow create: if playIsChunkOpen()
          && (
            request.resource.data.seq == 0
              ? request.resource.data.lastPosted.keys()
                  .hasOnly([playUid()])
              : (
                get(
                  /databases/$(database)/documents/playSessions/$(sessionId)/chunks/$(string(request.resource.data.seq - 1))
                ).data.messages.size() == 40
                && request.resource.data.lastPosted.diff(
                  get(
                    /databases/$(database)/documents/playSessions/$(sessionId)/chunks/$(string(request.resource.data.seq - 1))
                  ).data.lastPosted
                ).affectedKeys().hasOnly([playUid()])
                && (
                  !(playUid() in get(
                    /databases/$(database)/documents/playSessions/$(sessionId)/chunks/$(string(request.resource.data.seq - 1))
                  ).data.lastPosted)
                  || request.time > get(
                    /databases/$(database)/documents/playSessions/$(sessionId)/chunks/$(string(request.resource.data.seq - 1))
                  ).data.lastPosted[playUid()]
                    + duration.value(800, 'ms')
                )
              )
          );

        allow update: if (playMemberNow() && playIsChunkPost())
          || playIsChunkAdmit()
          || playIsChunkLeave();

        allow delete: if false;
      }

      match /seats/{seatUid} {
        allow get: if request.auth != null
          && seatUid == request.auth.uid;

        allow create, update: if playAuthed()
          && seatUid == playUid()
          && playUid() in playParent().memberIds
          && request.resource.data.keys()
            .hasOnly(['gameId', 'updatedAt'])
          && request.resource.data.gameId is string
          && request.resource.data.gameId.size() > 0
          && request.resource.data.gameId.size() <= 128
          && request.resource.data.updatedAt == request.time;

        allow list: if false;
        allow delete: if false;
      }
    }
  }
}
