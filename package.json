{
  "name": "inzone-games-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- npm run dev:inner",
    "dev:inner": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sdk:harness": "node --experimental-strip-types scripts/sdk-harness/server.mjs",
    "sdk:host": "node --experimental-strip-types scripts/sdk-host-harness/server.mjs",
    "test:sdk-harness": "node --experimental-strip-types --test tests/sdk-harness.test.mjs",
    "test:game-sdk": "node --experimental-strip-types --test tests/game-sdk-host.test.mjs tests/existing-games.test.mjs",
    "test:checkout-client": "node --test packages/checkout-host-client/client.test.mjs",
    "test:game-sdk-browser": "node --experimental-strip-types tests/game-sdk-host.browser.mjs",
    "test:legacy-games-browser": "node --experimental-strip-types tests/legacy-games.browser.mjs",
    "test:session-prototype": "node --experimental-strip-types --test tests/session-prototype.test.mjs tests/play-session.test.mjs",
    "test:play-session-rules": "firebase emulators:exec --only firestore --project demo-inzone \"node --test tests/play-session.rules.test.mjs\"",
    "test:play-session-live": "node tests/play-session.live.browser.mjs"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hexclave/next": "^1.0.112",
    "@inzone/checkout-host-client": "file:packages/checkout-host-client",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.0.0",
    "jszip": "^3.10.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@hexclave/cli": "^1.0.112",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "firebase-tools": "^15.30.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
